notation fn_restriction
    term ::= term " ↾ " term
end

definition
    f ↾ A := {x ∈ f | π₁(x) ∈ A}
end

theorem fn.restriction.is [f X : term] : (f : Fn)
    |- f ↾ X : Fn
proof
    todo
qed

theorem fn.restriction.pairs [f X : term] : (f : Fn)
    |- f ↾ X = {⟨x, f(x)⟩ | x ∈ dom(f) ∩ X}
proof
    todo
qed

theorem fn.restriction.eq [f g X : term] : (f : Fn) (g : Fn) (dom(f) ∩ X = dom(g) ∩ X)
    (∀x ∈ dom(f) ∩ X, f(x) = g(x))
    |- f ↾ X = g ↾ X
proof
    -- chain f ↾ X 
    --     = {⟨x, f(x)⟩ | x ∈ dom(f) ∩ X} by fn.restriction.pairs;
    --     = {⟨x, g(x)⟩ | x ∈ dom(f) ∩ X} given ∀x ∈ X, f(x) = g(x);
    --     = {⟨x, g(x)⟩ | x ∈ dom(g) ∩ X} given dom(f) ∩ X = dom(g) ∩ X;
    --     = g ↾ X                        by fn.restriction.pairs;
    chain f ↾ X 
        = {⟨x, f(x)⟩ | x ∈ dom(f) ∩ X} as todo;
        = {⟨x, g(x)⟩ | x ∈ dom(f) ∩ X} as todo;
        = {⟨x, g(x)⟩ | x ∈ dom(g) ∩ X} as todo;
        = g ↾ X                        as todo;
qed

## Function properties & Composition

The image of a function under a set is the set resulting from applying the function to every element of the set

notation image_set
    term (1000) ::= term "[" term "]"
end

definition
    f:term [A] := {f(a) | a ∈ A}
end

theorem image.def [f A : term] :
    |- ∀y, y ∈ f[A] ↔ ∃a ∈ A, y = f(a)
proof
    suffices ∀y, y ∈ {f(a) | a ∈ A} ↔ ∃a ∈ A, y = f(a);
    thus ∀y, y ∈ {f(a) | a ∈ A} ↔ (∃a, a ∈ A ∧ y = f(a)) by set_map.def [f(_)] [A];
    done logically
qed

Trivially, the image of a subset of a domain is a subset of the range, with equality when finding the image of the domain

theorem dom.is_ran_under_image [f A B : term] : (f ∈ (A → B))
    |- f[A] = ran(f)
proof
    thus f : Fn by fn_on.is_fn;
    suffices f[dom(f)] = ran(f) by fn_on.is_fn;
    hence ∀y, y ∈ f[dom(f)] ↔ ∃a ∈ dom(f), y = f(a) by image.def;
    furthermore ∀y, y ∈ ran(f) ↔ ∃z ∈ f, y = π₂(z) by ran.def;
    indeed ∀y, y ∈ f[dom(f)] ↔ y ∈ ran(f) as
        arbitrary y;
        assume y ∈ f[dom(f)] then y ∈ ran(f) as
            obtain a st a ∈ dom(f) ∧ y = f(a) logically;
            hence ⟨a, f(a)⟩ ∈ f ↔ f(a) = f(a) by fn.apply_iff given a ∈ dom(f);
            follows π₂(⟨a, f(a)⟩) = f(a) by opair_second.def;
            done by ran.def given ⟨a, f(a)⟩ ∈ f
            ;
        assume y ∈ ran(f) then y ∈ f[dom(f)] as
            follows f ⊆ A × B by rel_on.def, fn.in_rel, sub.def;
            obtain b st b ∈ f ∧ y = π₂(b) logically;
            hence b ∈ A × B by sub.def;
            obtain a st a ∈ A and c st c ∈ B ∧ b = ⟨a, c⟩ by cart_prod.def;
            furthermore π₂(b) = c by opair_second.def given b = ⟨a, c⟩;
            thus a = π₁(⟨a, c⟩) by opair_first.def;
            thus ⟨a, c⟩ ∈ f given b = ⟨a, c⟩;
            hence a ∈ dom(f) by dom.def given ⟨a, c⟩ ∈ f;
            follows ⟨a, c⟩ ∈ f ↔ f(a) = c by fn.apply_iff [f] [a] [c];
            follows f(a) = y logically;
            done by image.def given a ∈ dom(f)
            ;
        done logically
        ;
    done by zfc.extensionality
qed


Importantly, every image has a preimage, which we'll have as the set of terms which are mapped to a specific set under a function

notation preimage_set
    term (1000) ::= term "⁻¹" "[" term "]"
end

definition
    f:term⁻¹[A] := {x ∈ dom(f) | f(x) ∈ A}
end

theorem preimage.def [f A : term] :
    |- ∀x, x ∈ f⁻¹[A] ↔ (x ∈ dom(f) ∧ f(x) ∈ A)
proof
    suffices ∀x, x ∈ {x ∈ dom(f) | f(x) ∈ A} ↔ (x ∈ dom(f) ∧ f(x) ∈ A);
    done by zfc.extensionality
qed

A surjection, also known as an onto function, between sets is a mapping where the range is the same as the codomain

notation surjection
    term ::= term " ↠ " term
end

definition
    A ↠ B := {f ∈ (A → B) | ran(f) = B}
end

theorem surj_on.def [A B : term] :
    |- ∀f, f ∈ (A ↠ B) ↔ (f ∈ (A → B) ∧ ran(f) = B)
proof
    suffices ∀f, f ∈ {f ∈ (A → B) | ran(f) = B} ↔ (f ∈ (A → B) ∧ ran(f) = B);
    done by zfc.extensionality
qed

An injection, a one-to-one function, between sets is one where every element of the domain is mapped to a unique element in the range

notation injection
    term ::= term " ↣ " term
end

definition
    A ↣ B := {f ∈ (A → B) | ∀x, ∀y, x ∈ A ∧ y ∈ A ∧ f(x) = f(y) → x = y}
end

theorem inj_on.def [A B : term] :
    |- ∀f, f ∈ (A ↣ B) ↔ (f ∈ (A → B) ∧ (∀x, ∀y, x ∈ A ∧ y ∈ A ∧ f(x) = f(y) → x = y))
proof
    suffices ∀f, f ∈ {f ∈ (A → B) | ∀x, ∀y, x ∈ A ∧ y ∈ A ∧ f(x) = f(y) → x = y} ↔ (f ∈ (A → B) ∧ (∀x, ∀y, x ∈ A ∧ y ∈ A ∧ f(x) = f(y) → x = y));
    done by zfc.extensionality
qed

definition
    f : Inj := f ∈ (dom(f) ↣ ran(f))
end

theorem inj.def [f : term] :
    |- f : Inj ↔ f ∈ (dom(f) ↣ ran(f))
proof
    done by iff.refl [f : Inj]
qed

A bijection between sets is a function that is both injective and surjective

notation bijection
    term ::= term " ↔ " term
end

definition
    A ↔ B := {f ∈ (A ↣ B) | ran(f) = B}
end

theorem bij_on.def [A B : term] :
    |- ∀f, f ∈ (A ↔ B) ↔ (f ∈ (A ↣ B) ∧ ran(f) = B)
proof
    suffices ∀f, f ∈ {f ∈ (A ↣ B) | ran(f) = B} ↔ (f ∈ (A ↣ B) ∧ ran(f) = B);
    done by zfc.extensionality
qed

definition
    f : Bij := f ∈ (dom(f) ↔ ran(f))
end

theorem bij.def [f : term] :
    |- f : Bij ↔ f ∈ (dom(f) ↔ ran(f))
proof
    done by iff.refl [f : Bij]
qed

This theorem follows cleanly from the definitions for injective, bijective, and surjective functions

theorem bij_on.is_inj_and_surj [f A B : term] :
    |- f ∈ (A ↔ B) ↔ (f ∈ (A ↣ B) ∧ f ∈ (A ↠ B))
proof
    follows f ∈ (A ↔ B) ↔ (f ∈ (A ↣ B) ∧ ran(f) = B) by bij_on.def;
    follows f ∈ (A ↠ B) ↔ (f ∈ (A → B) ∧ ran(f) = B) by surj_on.def;
    follows f ∈ (A ↣ B) → f ∈ (A → B) by inj_on.def;
    done logically
qed

We can define an inverse relation simply as the swapped coordinates of the relation

notation inverse_relation
    term (1000) ::= term "⁻¹"
end

definition
    f:term⁻¹ := {⟨π₂(p), π₁(p)⟩ | p ∈ f}
end

Swapping the components of every pair in f swaps the roles of the domain and the range.

lemma inv.dom [f : term] :
    |- dom(f⁻¹) = ran(f)
proof
    follows ∀x, x ∈ dom(f⁻¹) ↔ ∃y ∈ f⁻¹, x = π₁(y) by dom.def;
    thus ∀y, y ∈ f⁻¹ ↔ ∃p ∈ f, y = ⟨π₂(p), π₁(p)⟩ by set_map.def [⟨π₂(_), π₁(_)⟩] [f];
    follows ∀p, π₁(⟨π₂(p), π₁(p)⟩) = π₂(p) by opair_first.def;
    follows ∀x, x ∈ ran(f) ↔ ∃p ∈ f, x = π₂(p) by ran.def;
    hence ∀x, x ∈ dom(f⁻¹) ↔ x ∈ ran(f) logically;
    done by zfc.extensionality
qed

lemma inv.ran [f : term] :
    |- ran(f⁻¹) = dom(f)
proof
    follows ∀x, x ∈ ran(f⁻¹) ↔ ∃y ∈ f⁻¹, x = π₂(y) by ran.def;
    thus ∀y, y ∈ f⁻¹ ↔ ∃p ∈ f, y = ⟨π₂(p), π₁(p)⟩ by set_map.def [⟨π₂(_), π₁(_)⟩] [f];
    follows ∀p, π₂(⟨π₂(p), π₁(p)⟩) = π₁(p) by opair_second.def;
    follows ∀x, x ∈ dom(f) ↔ ∃p ∈ f, x = π₁(p) by dom.def;
    hence ∀x, x ∈ ran(f⁻¹) ↔ x ∈ dom(f) logically;
    done by zfc.extensionality
qed

The following proof gives us a way to reason with and construct what f⁻¹ looks like

lemma inv.mem [f A B : term] : (f ∈ Rel(A, B))
    |- ∀a, ∀b, ⟨a, b⟩ ∈ f⁻¹ ↔ ⟨b, a⟩ ∈ f
proof
    arbitrary a; arbitrary b;
    follows f ⊆ A × B by rel_on.def;
    thus ∀y, y ∈ f⁻¹ ↔ ∃p ∈ f, y = ⟨π₂(p), π₁(p)⟩ by set_map.def [⟨π₂(_), π₁(_)⟩] [f];
    assume ⟨b, a⟩ ∈ f then ⟨a, b⟩ ∈ f⁻¹ as
        follows π₁(⟨b, a⟩) = b by opair_first.def;
        follows π₂(⟨b, a⟩) = a by opair_second.def;
        hence ⟨a, b⟩ = ⟨π₂(⟨b, a⟩), π₁(⟨b, a⟩)⟩ logically;
        done logically
        ;
    assume ⟨a, b⟩ ∈ f⁻¹ then ⟨b, a⟩ ∈ f as
        obtain p st p ∈ f ∧ ⟨a, b⟩ = ⟨π₂(p), π₁(p)⟩ logically;
        follows p ∈ A × B by sub.def given f ⊆ A × B;
        obtain c st c ∈ A and d st d ∈ B ∧ p = ⟨c, d⟩ by cart_prod.def;
        follows π₁(p) = c by opair_first.def given p = ⟨c, d⟩;
        follows π₂(p) = d by opair_second.def given p = ⟨c, d⟩;
        follows a = d ∧ b = c by opair.eq given ⟨a, b⟩ = ⟨π₂(p), π₁(p)⟩;
        done logically
        ;
    done logically
qed

The inverse of a relation between A and B is itself a relation, between B and A.

lemma inv.rel [f A B : term] : (f ∈ Rel(A, B))
    |- f⁻¹ ∈ Rel(B, A)
proof
    -- A relation is just some subset of the cartesian product
    follows f ⊆ A × B by rel_on.def;
    follows ∀a, ∀b, ⟨a, b⟩ ∈ f⁻¹ ↔ ⟨b, a⟩ ∈ f by inv.mem;
    suffices ∀y, y ∈ f⁻¹ → y ∈ B × A by rel_on.def, sub.def;
    arbitrary y;
    assume y ∈ f⁻¹ then y ∈ B × A as
        -- every element of f⁻¹ is a swapped pair from f
        thus ∀z, z ∈ f⁻¹ ↔ ∃p ∈ f, z = ⟨π₂(p), π₁(p)⟩ by set_map.def [⟨π₂(_), π₁(_)⟩] [f];
        obtain p st p ∈ f ∧ y = ⟨π₂(p), π₁(p)⟩ logically;
        -- inv.mem swaps the pair back into f
        follows ⟨π₁(p), π₂(p)⟩ ∈ f by inv.mem;
        follows ⟨π₁(p), π₂(p)⟩ ∈ A × B by sub.def given f ⊆ A × B;
        hence π₁(p) ∈ A ∧ π₂(p) ∈ B by cart_prod.def, opair.eq;
        done by cart_prod.def
        ;
qed

When f is a bijection, its inverse is a function, every b ∈ B has a
preimage because f is onto, and that preimage is unique because f is injective.

lemma inv.is_fn_on [f A B : term] : (f ∈ (A ↔ B))
    |- f⁻¹ ∈ (B → A)
proof
    indeed f ∈ (A ↣ B) ∧ ran(f) = B by bij_on.def;
    hence f ∈ (A → B) ∧ f : Fn ∧ dom(f) = A by inj_on.def, fn_on.is_fn;
    furthermore ∀a, ∀b, a ∈ A ∧ b ∈ A ∧ f(a) = f(b) → a = b by inj_on.def;
    furthermore f ∈ Rel(A, B) by fn.in_rel, sub.def;
    follows f⁻¹ ∈ Rel(B, A) by inv.rel given f ∈ Rel(A, B);
    thus ∀a, ∀b, ⟨a, b⟩ ∈ f⁻¹ ↔ ⟨b, a⟩ ∈ f by inv.mem given f ∈ Rel(A, B);
    suffices ∀b ∈ B, ∃!a, ⟨b, a⟩ ∈ f⁻¹ by fn_on.def;
    arbitrary d;
    assume d ∈ B then ∃!a, ⟨d, a⟩ ∈ f⁻¹ as
        -- Every element of B is in the image of f[A] so a exists
        obtain a₀ st a₀ ∈ A ∧ d = f(a₀) by image.def, dom.is_ran_under_image;
        hence ⟨a₀, d⟩ ∈ f ∧ ⟨d, a₀⟩ ∈ f⁻¹ by fn.apply_iff given a₀ ∈ A;
        -- any preimage of d is exactly a because f is injective
        hence ∀a, ⟨d, a⟩ ∈ f⁻¹ → a ∈ dom(f) ∧ f(a) = d by dom.def, opair_first.def, fn.apply_iff;
        done logically
        ;
    done logically
qed

Next we show that bijections undo their inverse

lemma inv.apply [f A B b : term] : (f ∈ (A ↔ B)) (b ∈ B)
    |- f(f⁻¹(b)) = b
proof
    indeed f ∈ (A → B) ∧ f : Fn ∧ dom(f) = A by bij_on.def, inj_on.def, fn_on.is_fn;
    furthermore f ∈ Rel(A, B) by fn.in_rel, sub.def;
    hence ∀u, ∀v, ⟨u, v⟩ ∈ f⁻¹ ↔ ⟨v, u⟩ ∈ f by inv.mem;
    follows f⁻¹ : Fn ∧ dom(f⁻¹) = B by inv.is_fn_on, fn_on.is_fn;
    hence ⟨b, f⁻¹(b)⟩ ∈ f⁻¹ ∧ ⟨f⁻¹(b), b⟩ ∈ f by fn.apply_iff given b ∈ B;
    follows f⁻¹(b) ∈ dom(f) by dom.def, opair_first.def given ⟨f⁻¹(b), b⟩ ∈ f;
    done by fn.apply_iff given ⟨f⁻¹(b), b⟩ ∈ f and f⁻¹(b) ∈ dom(f)
qed

notation function_composition
    term (400) ::= term " ∘ " term
end

definition
    g ∘ f := {⟨x, g(f(x))⟩ | x ∈ {x ∈ dom(f) | f(x) ∈ dom(g)}}
end

theorem composition.def [f g : term] :
    |- ∀y, y ∈ (g ∘ f) ↔ ∃x, (x ∈ dom(f) ∧ f(x) ∈ dom(g)) ∧ y = ⟨x, g(f(x))⟩
proof
    follows ∀y, y ∈ (g ∘ f) ↔ ∃x ∈ {x ∈ dom(f) | f(x) ∈ dom(g)}, y = ⟨x, g(f(x))⟩
        by set_map.def [⟨_, g(f(_))⟩] [{x ∈ dom(f) | f(x) ∈ dom(g)}];
    hence ∀x, x ∈ {x ∈ dom(f) | f(x) ∈ dom(g)} ↔ (x ∈ dom(f) ∧ f(x) ∈ dom(g))
        by comp.def [f(_) ∈ dom(g)] [dom(f)];
    done logically
qed

theorem composition.dom [f g : term] :
    |- ∀x, x ∈ dom(g ∘ f) ↔ (x ∈ dom(f) ∧ f(x) ∈ dom(g))
proof
    follows ∀z, z ∈ dom(g ∘ f) ↔ ∃y ∈ (g ∘ f), z = π₁(y) by dom.def;
    furthermore ∀y, y ∈ (g ∘ f) ↔ ∃x, (x ∈ dom(f) ∧ f(x) ∈ dom(g)) ∧ y = ⟨x, g(f(x))⟩ by composition.def;
    indeed ∀x, π₁(⟨x, g(f(x))⟩) = x by opair_first.def;
    done logically
qed

Here we show that function composition is itself a function

theorem composition.is_fn [f g : term] : (f : Fn) (g : Fn)
    |- g ∘ f : Fn
proof
    -- We want to show that the composition is some functional relation between two sets
    suffices ∃A, ∃B, g ∘ f ∈ (A → B) by fn.is_fn_on;
    thus ∀x ∈ {x ∈ dom(f) | f(x) ∈ dom(g)}, g(f(x)) ∈ ran(g) as
        -- The construction here is simple as we only pick x where f(x) is in dom(g), because
        -- g(dom(g)) being in ran(g) falls out of the definition
        arbitrary c st c ∈ {x ∈ dom(f) | f(x) ∈ dom(g)};
        follows g(f(c)) ∈ ran(g) as
            follows ∀x, x ∈ {x ∈ dom(f) | f(x) ∈ dom(g)} ↔ (x ∈ dom(f) ∧ f(x) ∈ dom(g))
                by comp.def [f(_) ∈ dom(g)] [dom(f)];
            thus f(c) ∈ dom(g) logically;
            hence ⟨f(c), g(f(c))⟩ ∈ g ↔ g(f(c)) = g(f(c)) by fn.apply_iff [g] [f(c)] [g(f(c))];
            hence ⟨f(c), g(f(c))⟩ ∈ g logically;
            follows π₂(⟨f(c), g(f(c))⟩) = g(f(c)) by opair_second.def;
            done by ran.def given ⟨f(c), g(f(c))⟩ ∈ g
            ;
        done logically
        ;
    -- g ∘ f is a functional mapping from dom(g ∘ f) to ran(g)
    follows g ∘ f ∈ ({x ∈ dom(f) | f(x) ∈ dom(g)} → ran(g))
        by fun_map.is.rel [{x ∈ dom(f) | f(x) ∈ dom(g)}] [ran(g)] [g(f(_))];
    done logically
qed

This theorem follows cleanly from the above facts. 

theorem composition.apply [f g a : term] : (f : Fn) (g : Fn) (a ∈ dom(g ∘ f))
    |- (g ∘ f)(a) = g(f(a))
proof
    hence a ∈ dom(f) ∧ f(a) ∈ dom(g) by composition.dom;
    furthermore ∀y, y ∈ (g ∘ f) ↔ ∃x, (x ∈ dom(f) ∧ f(x) ∈ dom(g)) ∧ y = ⟨x, g(f(x))⟩ by composition.def;
    furthermore ⟨a, g(f(a))⟩ ∈ (g ∘ f) logically;
    indeed g ∘ f : Fn by composition.is_fn;
    furthermore ⟨a, g(f(a))⟩ ∈ (g ∘ f) ↔ (g ∘ f)(a) = g(f(a)) by fn.apply_iff [g ∘ f] [a] [g(f(a))];
    done logically
qed

theorem composition.is_fn_on [f g A B C : term] : (f ∈ (A → B)) (g ∈ (B → C))
    |- g ∘ f ∈ (A → C)
proof
    hence g ∘ f : Fn by composition.is_fn, fn.is_fn_on;
    hence ∀x, x ∈ dom(g ∘ f) ↔ (x ∈ dom(f) ∧ f(x) ∈ dom(g)) by composition.dom;
    follows f ∈ (A → B) → dom(f) = A ∧ ran(f) ⊆ B by fn_on.is_fn;
    follows g ∈ (B → C) → dom(g) = B ∧ ran(g) ⊆ C by fn_on.is_fn;
    indeed ∀x, x ∈ dom(g ∘ f) ↔ (x ∈ A ∧ f(x) ∈ B) logically;
    hence ∀x, x ∈ A → f(x) ∈ B as
        arbitrary c st c ∈ A;
        follows f(c) ∈ B as
            indeed c ∈ dom(f) logically;
            hence ⟨c, f(c)⟩ ∈ f as
                indeed f : Fn by fn.is_fn_on;
                thus ⟨c, f(c)⟩ ∈ f ↔ f(c) = f(c) by fn.apply_iff [f] [c] [f(c)];
                done logically
                ;
            follows f(c) ∈ ran(f) by opair_second.def, ran.def given ⟨c, f(c)⟩ ∈ f;
            done by sub.def given ran(f) ⊆ B
            ;
        ;
    hence ∀x, x ∈ dom(g ∘ f) ↔ x ∈ A logically;
    hence dom(g ∘ f) = A by zfc.extensionality;
    thus ran(g ∘ f) ⊆ C as
        suffices ∀y, y ∈ ran(g ∘ f) → y ∈ C by sub.def;
        arbitrary y;
        assume y ∈ ran(g ∘ f) then y ∈ C as
            obtain p st p ∈ (g ∘ f) ∧ y = π₂(p) by ran.def;
            obtain x st (x ∈ dom(f) ∧ f(x) ∈ dom(g)) ∧ p = ⟨x, g(f(x))⟩ by composition.def;
            indeed g : Fn by fn.is_fn_on;
            furthermore f(x) ∈ dom(g) logically;
            follows ⟨f(x), g(f(x))⟩ ∈ g ↔ g(f(x)) = g(f(x)) by fn.apply_iff [g] [f(x)] [g(f(x))];
            hence ⟨f(x), g(f(x))⟩ ∈ g logically;
            follows g(f(x)) ∈ ran(g) by ran.def, opair_second.def given ⟨f(x), g(f(x))⟩ ∈ g;
            done by opair_second.def, sub.def given ran(g) ⊆ C
            ;
        done logically
        ;
    done by fn_on.is_fn
qed

A function composed of two injective functions is itself injective. This is a standard injectivity proof
where we reason that g(f(x)) = g(f(y)) implies f(x) = f(y) which impliex x = y

theorem comp_inj.is_inj [f g A B C : term] : (f ∈ (A ↣ B)) (g ∈ (B ↣ C))
    |- g ∘ f ∈ (A ↣ C)
proof
    follows g ∘ f ∈ (A → C) by composition.is_fn_on, inj_on.def;
    suffices ∀x, ∀y, x ∈ A ∧ y ∈ A ∧ (g ∘ f)(x) = (g ∘ f)(y) → x = y by inj_on.def;
    arbitrary x; arbitrary y;
    assume x ∈ A ∧ y ∈ A ∧ (g ∘ f)(x) = (g ∘ f)(y) then x = y as
        follows f ∈ (A → B) ∧ g ∈ (B → C) by inj_on.def;
        indeed (∀a, ∀b, a ∈ A ∧ b ∈ A ∧ f(a) = f(b) → a = b)
              ∧ (∀a, ∀b, a ∈ B ∧ b ∈ B ∧ g(a) = g(b) → a = b) by inj_on.def;
        indeed f : Fn ∧ g : Fn by fn.is_fn_on;
        thus dom(g ∘ f) = A ∧ dom(g) = B by fn_on.is_fn;
        hence x ∈ dom(g ∘ f) ∧ y ∈ dom(g ∘ f) logically;
        follows g(f(x)) = g(f(y)) by composition.apply;
        furthermore f(x) ∈ B ∧ f(y) ∈ B by composition.dom;
        thus f(x) = f(y) logically;
        done logically
        ;
    done logically
qed

The following proof where we show composition of surjective functions is surjective takes a different
shape. We want to show that some c in ran(g) has a preimage in dom(g) and then that dom(g) = ran(f).

theorem comp_surj.is_surj [f g A B C : term] : (f ∈ (A ↠ B)) (g ∈ (B ↠ C))
    |- g ∘ f ∈ (A ↠ C)
proof
    follows g ∘ f ∈ (A → C) by composition.is_fn_on, surj_on.def;
    suffices ran(g ∘ f) = C by surj_on.def;
    follows f ∈ (A → B) ∧ ran(f) = B ∧ g ∈ (B → C) ∧ ran(g) = C by surj_on.def;
    hence f : Fn ∧ g : Fn by fn_on.is_fn;
    thus dom(f) = A ∧ dom(g) = B ∧ ran(g ∘ f) ⊆ C by fn_on.is_fn;
    thus f[A] = ran(f) ∧ g[B] = ran(g) ∧ (g ∘ f)[A] = ran(g ∘ f) by dom.is_ran_under_image;
    furthermore ∀y, y ∈ f[A] ↔ ∃z ∈ A, y = f(z) by image.def;
    follows ∀y, y ∈ g[B] ↔ ∃z ∈ B, y = g(z) by image.def;
    suffices C ⊆ ran(g ∘ f) by sub.sub_eq;
    suffices ∀c, c ∈ C → c ∈ ran(g ∘ f) by sub.def;
    arbitrary c;
    assume c ∈ C then c ∈ ran(g ∘ f) as
        obtain b st b ∈ B ∧ c = g(b) logically;
        obtain a st a ∈ A ∧ b = f(a) logically;
        thus a ∈ dom(g ∘ f) by composition.dom;
        follows (g ∘ f)(a) = c by composition.apply;
        done by image.def given a ∈ A
        ;
    done logically
qed

This lemma looks a bit weird, but the idea is that we want to be able to reason about where in B f has an inverse

lemma inj.is_bij_to_ran [f A B : term] : (f ∈ (A ↣ B))
    |- f ∈ (A ↔ ran(f))
proof
    suffices f ∈ (A ↣ ran(f)) by bij_on.def;
    suffices (f ∈ (A → ran(f))) ∧ (∀x, ∀y, x ∈ A ∧ y ∈ A ∧ f(x) = f(y) → x = y) by inj_on.def;
    hence f : Fn ∧ dom(f) = A by fn_on.is_fn, inj_on.def;
    follows ran(f) ⊆ ran(f) by sub.refl;
    indeed f ∈ (A → ran(f)) by fn_on.is_fn;
    done by inj_on.def
qed

lemma sub.has_surj [S B : term]: (S ⊆ B) (S ≠ ∅)
    |- ∃h, h ∈ (B ↠ S)
proof
    todo
qed

One of the most important properties of a bijective function is that it defines a unique bijective 
inverse. The proof follows cleanly from the previous inverse theorems.

theorem bij.has_inverse [f A B : term] : (f ∈ (A ↔ B))
    |- f⁻¹ ∈ (B ↔ A)
proof
    follows f⁻¹ ∈ (B → A) by inv.is_fn_on;
    follows dom(f) = A by bij_on.def, inj_on.def, fn_on.is_fn;
    follows ran(f⁻¹) = A by inv.ran given dom(f) = A;
    thus ∀x, ∀y, x ∈ B ∧ y ∈ B ∧ f⁻¹(x) = f⁻¹(y) → x = y as
        arbitrary x; arbitrary y;
        assume x ∈ B ∧ y ∈ B ∧ f⁻¹(x) = f⁻¹(y) then x = y as
            follows f(f⁻¹(x)) = x ∧ f(f⁻¹(y)) = y by inv.apply;
            done logically
            ;
        done logically
        ;
    follows f⁻¹ ∈ (B ↣ A) by inj_on.def;
    done by bij_on.def
qed

Here we have that an injection between sets implies the existence of a surjection the other way. 
We'll use this lemma later to explicitly construct this surjection. This lemma follows from the previous few where we show
a surjection from B to ran(f) via sub.has_surj and ran(f) to A via bij.has_inverse as inj.is_bij_to_ran gives us a bijection between A and ran(f)

lemma inj.is_inv_srj [f g A B : term] : (f ∈ (A ↣ B)) (A ≠ ∅)
    |- ∃g, g ∈ (B ↠ A)
proof
    follows f ∈ (A → B) by inj_on.def;
    hence f[A] = ran(f) by dom.is_ran_under_image;
    suffices ∃h, ∃w, h ∈ (B ↠ ran(f)) ∧ w ∈ (ran(f) ↠ A) by comp_surj.is_surj;
    hence ∃w, w ∈ (ran(f) ↠ A) as
        follows f ∈ (A ↔ ran(f)) by inj.is_bij_to_ran;
        furthermore ∃w₀, w₀ ∈ (ran(f) ↔ A) by bij.has_inverse;
        done by bij_on.is_inj_and_surj
        ;
    furthermore ran(f) ⊆ B by fn_on.is_fn;
    follows ran(f) ≠ ∅ by image.def, nonempty.has_element;
    hence ∃h, h ∈ (B ↠ ran(f)) by sub.has_surj;
    done by comp_surj.is_surj
qed

theorem shroeder_bernstein [A B : term] : (∃f, f ∈ (A ↣ B)) (∃g, g ∈ (B ↣ A))
    |- ∃h, h ∈ (A ↔ B)
proof
